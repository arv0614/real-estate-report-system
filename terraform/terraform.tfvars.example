# このファイルをコピーして terraform.tfvars を作成し、実際の値を入力してください
# cp terraform.tfvars.example terraform.tfvars

project_id             = "your-gcp-project-id"
region                 = "asia-northeast1"
cache_bucket_name      = "your-project-id-realestate-cache"
bq_dataset_id          = "realestate_cache"
cloud_run_service_name          = "realestate-api"
frontend_cloud_run_service_name = "realestate-frontend"
cache_ttl_days                  = 30

# Cloud Run コンテナに注入する環境変数（稼働中の値と一致させること）。
# scripts/terraform_apply.sh を使う場合はプロジェクトルート .env から自動生成される。
mlit_api_key        = "your-mlit-api-key"
gemini_api_key      = "your-gemini-api-key"
estat_api_key       = "your-estat-api-key"
allowed_origins     = "https://your-domain.com,https://your-frontend.run.app"
admin_emails        = "admin@example.com"
firebase_project_id = "your-firebase-project-id"
